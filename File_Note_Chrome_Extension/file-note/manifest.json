{
  "manifest_version": 3,
  "name": "File Note — PDFに書き込み、Word・PowerPointを表示",
  "version": "1.7.0",
  "description": "必要なときだけPDFに文字・線・写真を追加。Word・PowerPointは閲覧のみ。処理は端末内で完結します。",
  "minimum_chrome_version": "130",
  "permissions": ["activeTab"],
  "host_permissions": ["file:///*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "File Noteで開く" },
  "icons": {"16":"icons/16.png", "48":"icons/48.png", "128":"icons/128.png"},
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none';" }
}




